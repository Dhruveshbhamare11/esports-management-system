# eSports Nexus Backend Environment Configuration Template
# Copy this file to .env or export these variables in your environment.
# DO NOT commit real passwords or secrets to source control.

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=esports_nexus
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Security & CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_TIMEOUT_SECONDS=86400
